*/dist/
demo/samples/
demo/verify-report.json
fold/tests/shots/

# Logs and locks
*.log
.refresh.lock/

# Host state
.netlify/
.wrangler/
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store
