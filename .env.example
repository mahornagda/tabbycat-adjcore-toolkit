# How the toolkit signs in to your tab. Copy this file to .env and fill in ONE
# of the two options below (or both — see the note at the end).
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; . .env; set +a      # load it into your shell
#
# .env is gitignored. Never commit it, never paste it into a chat, and never put
# any of this in tournament.json.


# ---------------------------------------------------------------------------
# OPTION 1 — a token. Prefer this.
# ---------------------------------------------------------------------------
# Tabbycat generates one for every user. Find yours on your tab's home page,
# under "Change Password". (On installations where you can reach the Edit
# Database area it is also listed there, under "Tokens".)
#
# A token is better than a password for the same reason a key is better than a
# lock: it can be revoked on its own, from that same page, without changing
# anything else you use.

export TABBY_TOKEN=


# ---------------------------------------------------------------------------
# OPTION 2 — your ordinary tab sign-in.
# ---------------------------------------------------------------------------
# The same username and password you use in a browser. Not a private URL, and
# not an email address.

export TABBY_USER=
export TABBY_PASS=


# ---------------------------------------------------------------------------
# WHEN YOU NEED BOTH
# ---------------------------------------------------------------------------
# Two things the toolkit reads are ordinary admin pages rather than API
# endpoints — Tabbycat's feedback-progress table and its check-in status. A
# token authenticates the API but not a page, so those two need a username and
# password as well.
#
# In practice:
#   the fold + simulator     token alone is enough
#   judge feedback           token alone is enough
#   tester tracking          works on a token alone, but the "owes feedback"
#                            and "checked in" columns stay blank without a
#                            username and password too
#
# Either way, it must be a TAB-SIDE account — adjudication core or tabulation.
# A public or participant account cannot see feedback, panels, or a draw before
# it is released, which is most of what these tools read.
